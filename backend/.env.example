# Copy to backend/.env and fill in your real values.

# --- Database (local PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/muney

# --- Auth ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# Allows POST /api/auth/register only while zero users exist (first-run bootstrap).
ALLOW_BOOTSTRAP_REGISTRATION=true

# --- Money ---
BASE_CURRENCY=LKR
SUPPORTED_CURRENCIES=LKR,USD,SGD,EUR,GBP,AUD,INR

# --- FX rates ---
# fawazahmed0/currency-api: free, no API key, no rate limit. Rates are pivoted
# through USD, so `usd.json` must match FX_PIVOT_CURRENCY if you change it.
FX_API_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json
# Same data on a different host; used only when the primary is unreachable.
FX_FALLBACK_API_URL=https://latest.currency-api.pages.dev/v1/currencies/usd.json
FX_PIVOT_CURRENCY=USD
FX_STALE_AFTER_HOURS=12
# Second currency shown beside BASE_CURRENCY on the dashboard. Empty turns it off.
SECONDARY_CURRENCY=USD

# --- SMS forwarding ---
# Shared secret the iPhone Shortcut sends as X-Ingest-Token. Empty disables it.
# Generate with:  python -c "import secrets; print(secrets.token_hex(24))"
INGEST_TOKEN=

# ------------------------------------------------------------ AI reading
# Reads SMS formats no regex parser knows, and picks/creates categories.
#   llamacpp  on-board: llama.cpp's llama-server in the `llm` container.
#             Free, private, offline. ~7-15 s per SMS on a Pi, in the background.
#   anthropic Claude Haiku 5.5 via the API (needs ANTHROPIC_API_KEY). SMS text
#             is sent to Anthropic. Stop the llm container if you use this.
#   none      off — unread SMS wait in the inbox for you to record by hand
LLM_PROVIDER=none
# Running natively: point at a llama-server you started yourself.
LLAMACPP_URL=http://localhost:8080
LLM_MODEL=qwen2.5-1.5b
ANTHROPIC_API_KEY=
# Let the AI add a new category when nothing existing fits.
LLM_CREATE_CATEGORIES=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
