# Copy to backup.env on the Pi. Read only by scripts/backup-db.sh.
# Each destination is an independent on/off switch; the local copy always
# happens regardless.

# ------------------------------------------------------------ local copies
BACKUP_DIR=./backups
LOCAL_RETENTION_DAYS=14

# ----------------------------------------------------------- google drive
# Requires rclone configured with a remote (see DEPLOYMENT.md §7.1).
BACKUP_TO_GDRIVE=false
GDRIVE_REMOTE_NAME=gdrive
# Keep this distinct from the task dashboard's folder.
GDRIVE_FOLDER=muney-backups
GDRIVE_RETENTION_DAYS=30

# ------------------------------------------- another device on the tailnet
BACKUP_TO_REMOTE=false
REMOTE_USER=
REMOTE_HOST=
# Must already exist on the remote.
REMOTE_PATH=/backups/muney
REMOTE_SSH_KEY=~/.ssh/backup_key
