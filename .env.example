# Copy to .env on the Pi and fill in. This file is ONLY read by
# docker-compose.yml. It is separate from backend/.env and frontend/.env.local,
# which are for running natively on a dev machine — you do not need those here.

# ---------------------------------------------------------------- ports
# The task dashboard already uses 80, 8000 and 5432 on this Pi. Change these
# only if something else is on 8080/8001 too. Postgres is not published at all.
MUNEY_WEB_PORT=8080
MUNEY_API_PORT=8001

# ------------------------------------------------------------- database
POSTGRES_USER=muney
POSTGRES_PASSWORD=CHANGE_ME_TO_SOMETHING_REAL
POSTGRES_DB=muney
# Matches the Postgres 18 you run locally, so dumps move in either direction.
POSTGRES_IMAGE=postgres:18-alpine

# ----------------------------------------------------------------- auth
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# Leave true until you have created your account, then set false and redeploy.
ALLOW_BOOTSTRAP_REGISTRATION=true

# ---------------------------------------------------------------- money
BASE_CURRENCY=LKR
SUPPORTED_CURRENCIES=LKR,USD,SGD,EUR,GBP,AUD,INR
# fawazahmed0/currency-api — free, no key. `usd.json` must match FX_PIVOT_CURRENCY.
FX_API_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json
FX_FALLBACK_API_URL=https://latest.currency-api.pages.dev/v1/currencies/usd.json
FX_PIVOT_CURRENCY=USD
FX_STALE_AFTER_HOURS=12
# Second currency shown beside LKR on the dashboard. Empty turns it off.
SECONDARY_CURRENCY=USD

# ---------------------------------------------------------- SMS forwarding
# Shared secret your iPhone Shortcut sends as the X-Ingest-Token header.
# Generate with: openssl rand -hex 24. Empty disables /api/ingest/sms.
INGEST_TOKEN=
# ------------------------------------------------------------ AI reading
# Reads SMS formats no regex parser knows, and picks/creates categories.
#   llamacpp  on-board: llama.cpp's llama-server in the `llm` container.
#             Free, private, offline. ~7-15 s per SMS on a Pi, in the background.
#   anthropic Claude Haiku 5.5 via the API (needs ANTHROPIC_API_KEY). SMS text
#             is sent to Anthropic. Stop the llm container if you use this.
#   none      off — unread SMS wait in the inbox for you to record by hand
LLM_PROVIDER=llamacpp
# The GGUF llama-server downloads from Hugging Face on first start
# (<user>/<repo>:<quant>). Benchmark alternatives with scripts/llm_bench.py.
LLM_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
# Display name for that model (passed to llama-server as --alias).
LLM_MODEL=qwen2.5-1.5b
# CPU threads for inference — the Pi's core count.
LLM_THREADS=4
# Host port for llama.cpp's own chat web UI.
MUNEY_LLM_PORT=8090
ANTHROPIC_API_KEY=
# Let the AI add a new category when nothing existing fits.
LLM_CREATE_CATEGORIES=true

# ----------------------------------------------------------------- news
# How often feeds refresh in the background. 0 disables it (manual only).
NEWS_REFRESH_MINUTES=30
# Unsaved articles older than this are pruned. Saved ones are always kept.
NEWS_RETENTION_DAYS=60

TZ=Asia/Colombo

# ------------------------------------------------------------- frontend
# nginx proxies /api to the backend on the same origin, so this stays as-is.
# It does NOT need to contain the Pi's hostname, which means changing the
# Tailscale address never requires an image rebuild.
VITE_API_BASE_URL=/api

# Only matters if you call the API directly on MUNEY_API_PORT from a browser
# page served somewhere else. The app itself never does.
CORS_ORIGINS=http://localhost:8080
