# This repo is authored on Windows but deployed on Linux. Anything the Pi
# executes or parses must stay LF — a CRLF shebang fails with the notoriously
# unhelpful "bad interpreter: /bin/bash^M".
* text=auto eol=lf

*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env.example    text eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
